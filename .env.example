# ============================================================
# II-VMS Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ii_vms
DB_POOL_MAX=20
DB_SCHEMA_VERSION=2026.04.04.1
DB_SLOW_QUERY_MS=300
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=ii_vms

# ---- Admin Authentication ----
# IMPORTANT: Change these in production, or provide *_FILE paths.
ADMIN_API_KEY=replace-with-strong-random-admin-key
ADMIN_JWT_SECRET=replace-with-strong-random-jwt-secret
ADMIN_JWT_EXPIRES_IN=2h
ADMIN_API_KEY_FILE=
ADMIN_JWT_SECRET_FILE=
SERVICE_API_KEY=replace-with-random-service-key
SERVICE_API_KEY_FILE=

# ---- Email Notifications (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_PASS_FILE=

# ---- SMS Notifications (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_AUTH_TOKEN_FILE=
TWILIO_PHONE_NUMBER=

# ---- Notification Recipients ----
ADMIN_EMAIL=
ADMIN_PHONE=
ENABLE_SMS_ALERTS=false

# ---- AI Service (Google Gemini) ----
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=

# ---- Microservices ----
BIOMETRIC_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_URL=http://localhost:8001

# ---- Upstream Protection ----
UPSTREAM_CB_FAILURE_THRESHOLD=5
UPSTREAM_CB_RESET_TIMEOUT_MS=30000
UPSTREAM_CB_HALF_OPEN_SUCCESSES=2

# ---- Biometric Fallback Policy ----
BIOMETRIC_FALLBACK_ENABLED=true
BIOMETRIC_FALLBACK_MODE=manual_review_required
BIOMETRIC_FALLBACK_RETRY_AFTER_SECONDS=30

# ---- Analytics Reliability Monitor (Optional) ----
ANALYTICS_RELIABILITY_ENABLED=false
ANALYTICS_RELIABILITY_POLL_MS=15000
ANALYTICS_RELIABILITY_DEGRADED_CHECKS=2
ANALYTICS_RELIABILITY_HEALTHY_CHECKS=2
ANALYTICS_RELIABILITY_ALERT_COOLDOWN_MS=300000
ANALYTICS_RELIABILITY_BUFFER_THRESHOLD=100
ANALYTICS_RELIABILITY_FAILURE_THRESHOLD=3

# ---- Analytics Batch Scoring (ML) ----
ANALYTICS_SUSPICIOUS_THRESHOLDS=0.03,0.05,0.08
ANALYTICS_SUSPICIOUS_REFRESH_SECONDS=300
ANALYTICS_CALIBRATION_TARGET_RATE=0.05

# ---- Data Retention / Archival ----
RETENTION_ANALYTICS_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_BATCH_SIZE=1000

# ---- Performance Regression Checks ----
PERF_BASE_URL=http://localhost:4000
PERF_RUNS=8
PERF_ANALYTICS_P95_MS=1200
PERF_BIOMETRIC_P95_MS=1800
CONTRACT_BASE_URL=http://localhost:4000

# ---- Load Test Settings ----
LOAD_BASE_URL=http://localhost:4000
LOAD_DURATION_SECONDS=30
LOAD_CONCURRENCY=10
LOAD_MAX_ERROR_RATE=0.05
LOAD_MAX_P95_MS=2200

# ---- Chaos Test Settings ----
CHAOS_BASE_URL=http://localhost:4000
CHAOS_MODE=biometric_down
CHAOS_VISITOR_ID=1

# ---- Integration Test Settings ----
INTEGRATION_BASE_URL=http://localhost:4000
INTEGRATION_REQUIRE_BIOMETRIC=true

# ---- Frontend (Vite) ----
# Set this in frontend/.env
# VITE_API_BASE_URL=http://localhost:4000
