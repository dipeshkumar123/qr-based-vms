# ============================================================
# II-VMS Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/vms
DB_POOL_MAX=20

# ---- Admin Authentication ----
# IMPORTANT: Change these in production!
ADMIN_API_KEY=change-this-to-a-secure-random-string
ADMIN_JWT_SECRET=change-this-to-a-strong-jwt-secret
ADMIN_JWT_EXPIRES_IN=2h

# ---- Email Notifications (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- SMS Notifications (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Notification Recipients ----
ADMIN_EMAIL=
ADMIN_PHONE=
ENABLE_SMS_ALERTS=false

# ---- AI Service (Google Gemini) ----
GEMINI_API_KEY=

# ---- Microservices ----
BIOMETRIC_SERVICE_URL=http://localhost:8000
ANALYTICS_SERVICE_URL=http://localhost:8001

# ---- Frontend (Vite) ----
# Set this in frontend/.env
# VITE_API_BASE_URL=http://localhost:4000
