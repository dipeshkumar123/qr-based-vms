{
  "name": "ii-vms-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "migrate": "node scripts/migrate.js",
    "migration:smoke": "node scripts/migration_smoke_test.js",
    "contract:analytics": "node scripts/contract_analytics_test.js",
    "chaos:test": "node scripts/chaos_upstream_test.js",
    "integration:test": "node scripts/integration_test.js",
    "load:test": "node scripts/load_test.js",
    "perf:check": "node scripts/performance_regression_check.js",
    "ci:smoke": "npm run migrate; npm run migration:smoke",
    "ci:chaos": "npm run chaos:test",
    "ci:contract": "npm run contract:analytics",
    "ci:integration": "npm run integration:test",
    "ci:load": "npm run load:test",
    "ci:perf": "npm run perf:check",
    "ci:test": "npm run test",
    "retention": "node scripts/retention.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.12.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "twilio": "^5.11.1",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.32",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
}
