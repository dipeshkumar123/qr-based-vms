# ════════════════════════════════════════════════════════════════════
#  II-VMS Backend — Environment Variables
#  Copy to .env for local dev. On Railway, set via the dashboard.
# ════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────
# Railway automatically provides PORT. Do NOT hardcode it.
PORT=4000
NODE_ENV=production
# Comma-separated list of allowed CORS origins (no trailing slash)
CORS_ORIGIN=https://your-frontend.vercel.app
PUBLIC_BASE_URL=https://your-backend.up.railway.app
UPLOAD_DIR=uploads
LOG_LEVEL=info

# ── PostgreSQL (REQUIRED) ───────────────────────────────────────────
# Railway PostgreSQL: copy the DATABASE_URL from the Railway dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ii_vms
DB_POOL_MAX=20
DB_SCHEMA_VERSION=2026.04.05.1
DB_SLOW_QUERY_MS=300

# ── Admin Auth (REQUIRED — use strong random values in production) ───
ADMIN_API_KEY=replace-with-strong-random-admin-key-min-32-chars
ADMIN_JWT_SECRET=replace-with-strong-random-jwt-secret-min-32-chars
ADMIN_JWT_EXPIRES_IN=2h
# Optional: read secrets from files instead of env vars (Docker secrets)
ADMIN_API_KEY_FILE=
ADMIN_JWT_SECRET_FILE=

# ── Service-to-Service Auth (REQUIRED) ──────────────────────────────
# Shared key between backend ↔ biometric ↔ analytics services
SERVICE_API_KEY=replace-with-random-service-key-min-32-chars
SERVICE_API_KEY_FILE=

# ── Biometric Microservice ───────────────────────────────────────────
# Railway internal URL for the biometric service
BIOMETRIC_SERVICE_URL=https://your-biometric-service.up.railway.app

# ── Analytics Microservice ───────────────────────────────────────────
# Railway internal URL for the analytics service
ANALYTICS_SERVICE_URL=https://your-analytics-service.up.railway.app

# ── Gemini AI (Optional — gates AI features) ────────────────────────
# Set GEMINI_ENABLED=true to unlock AI-powered visitor insights (premium)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_PROMPT_CHARS=8000

# ── Email Notifications / SMTP ──────────────────────────────────────
# Use Gmail App Password or a transactional provider (SendGrid, Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=
SMTP_PASS_FILE=

# ── SMS Notifications / Twilio ──────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_AUTH_TOKEN_FILE=
TWILIO_PHONE_NUMBER=+1234567890

# ── Admin Contact for Alerts ─────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+1234567890
ENABLE_SMS_ALERTS=false

# ── Upstream Circuit Breaker ─────────────────────────────────────────
UPSTREAM_CB_FAILURE_THRESHOLD=5
UPSTREAM_CB_RESET_TIMEOUT_MS=30000
UPSTREAM_CB_HALF_OPEN_SUCCESSES=2

# ── Biometric Fallback Policy ────────────────────────────────────────
BIOMETRIC_FALLBACK_ENABLED=true
BIOMETRIC_FALLBACK_MODE=manual_review_required
BIOMETRIC_FALLBACK_RETRY_AFTER_SECONDS=30

# ── Analytics Reliability Monitor ────────────────────────────────────
ANALYTICS_RELIABILITY_ENABLED=false
ANALYTICS_RELIABILITY_POLL_MS=15000
ANALYTICS_RELIABILITY_DEGRADED_CHECKS=2
ANALYTICS_RELIABILITY_HEALTHY_CHECKS=2
ANALYTICS_RELIABILITY_ALERT_COOLDOWN_MS=300000
ANALYTICS_RELIABILITY_BUFFER_THRESHOLD=100
ANALYTICS_RELIABILITY_FAILURE_THRESHOLD=3

# ── Analytics Batch Scoring (ML) ──────────────────────────────────────
ANALYTICS_SUSPICIOUS_THRESHOLDS=0.03,0.05,0.08
ANALYTICS_SUSPICIOUS_REFRESH_SECONDS=300
ANALYTICS_CALIBRATION_TARGET_RATE=0.05

# ── Data Retention / Archival ─────────────────────────────────────────
RETENTION_ANALYTICS_DAYS=90
RETENTION_AUDIT_DAYS=365
RETENTION_BATCH_SIZE=1000

# ── Performance / Load / Chaos Tests (CI/CD only) ─────────────────────
PERF_BASE_URL=http://localhost:4000
PERF_RUNS=8
PERF_ANALYTICS_P95_MS=1200
PERF_BIOMETRIC_P95_MS=1800
CONTRACT_BASE_URL=http://localhost:4000
LOAD_BASE_URL=http://localhost:4000
LOAD_DURATION_SECONDS=30
LOAD_CONCURRENCY=10
LOAD_MAX_ERROR_RATE=0.05
LOAD_MAX_P95_MS=2200
CHAOS_BASE_URL=http://localhost:4000
CHAOS_MODE=biometric_down
CHAOS_VISITOR_ID=1
INTEGRATION_BASE_URL=http://localhost:4000
INTEGRATION_REQUIRE_BIOMETRIC=true
