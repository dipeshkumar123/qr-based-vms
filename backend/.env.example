# ── Server ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
LOG_LEVEL=info

# ── PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ii_vms
DB_POOL_MAX=20

# ── Admin Auth ─────────────────────────────────────────────────
ADMIN_API_KEY=change-me-very-strong
ADMIN_JWT_SECRET=change-me-super-secret
ADMIN_JWT_EXPIRES_IN=2h

# ── Biometric Microservice ─────────────────────────────────────
BIOMETRIC_SERVICE_URL=http://localhost:8000
BIOMETRICS_SERVICE_URL=http://localhost:8001

# ── Analytics Microservice ─────────────────────────────────────
ANALYTICS_SERVICE_URL=http://localhost:8001

# ── Gemini AI ──────────────────────────────────────────────────
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=12000
GEMINI_MAX_PROMPT_CHARS=8000

# ── Email Notifications (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── SMS Notifications (Twilio) ─────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── Admin Contact for Notifications ────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+1234567890
ENABLE_SMS_ALERTS=false

