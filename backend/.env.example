# Server configuration
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ii_vms

# Admin auth
ADMIN_API_KEY=change-me-very-strong
ADMIN_JWT_SECRET=change-me-super-secret
ADMIN_JWT_EXPIRES_IN=2h

# Biometric microservice
BIOMETRIC_SERVICE_URL=http://localhost:8000

# Analytics microservice
ANALYTICS_SERVICE_URL=http://localhost:8001

# Email notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Admin contact for notifications
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+1234567890

# Notification settings
ENABLE_SMS_ALERTS=false

