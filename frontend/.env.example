# ── Frontend Environment Variables ──────────────────────────────────
# Copy this file to .env.local for local development
# On Vercel, set these via the Vercel Dashboard or CLI

# ── Backend API URL (REQUIRED) ──────────────────────────────────────
# Local development: http://localhost:4000
# Production (Vercel): https://your-backend.up.railway.app
VITE_API_BASE_URL=http://localhost:4000

# ── Bundle Budget Checks (CI only) ──────────────────────────────────
# Used by: npm run bundle:budget
BUNDLE_JS_BUDGET_KB=1300
BUNDLE_CSS_BUDGET_KB=90
BUNDLE_CHUNK_BUDGET_KB=480
